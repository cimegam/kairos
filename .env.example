# Configurações do Servidor
PORT=3000
NODE_ENV=production

# ⚠️ OBRIGATÓRIO EM PRODUÇÃO: Gere uma senha forte para o barbeiro entrar no painel
ADMIN_PASSWORD=defina_uma_senha_forte_aqui_123

# ⚠️ OBRIGATÓRIO: Um código aleatório longo para assinar os tokens JWT (ex: use letras e números misturados)
JWT_SECRET=coloque_um_hash_aleatorio_longo_aqui_987654321

# BANCO DE DADOS:
# 1. Se usar Render com PostgreSQL Gratuito ou Supabase (RECOMENDADO para custo zero e zero perda de dados):
# DATABASE_URL=postgresql://postgres.xxx:senha@host:5432/postgres
#
# 2. Se não configurar DATABASE_URL, o sistema usará automaticamente o arquivo JSON local abaixo:
DATA_FILE=./data/barbearia_data.json
